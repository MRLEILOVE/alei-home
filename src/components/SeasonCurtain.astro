<div class="season-pull" id="season-pull" hidden>
  <span class="pull-mount" aria-hidden="true"></span>
  <span class="pull-cord" aria-hidden="true"></span>
  <button
    class="pull-handle"
    id="season-pull-handle"
    type="button"
    aria-label="拉动切换季节"
    aria-describedby="season-pull-instructions"
  >
    <span class="pull-grip" aria-hidden="true">
      <span id="season-pull-label">秋</span>
      <svg viewBox="0 0 20 12" width="15" height="9">
        <path d="M10 1v8M6 6l4 4 4-4" />
      </svg>
    </span>
  </button>
  <span class="sr-only" id="season-pull-instructions">
    向下拉动后松手，或点击、按回车键，依次切换春夏秋冬。
  </span>
  <div class="pull-hint" id="season-pull-hint" hidden>
    <span>拉一下试试看！</span>
    <svg class="hint-arrow" viewBox="0 0 31 24" width="31" height="24" aria-hidden="true">
      <path d="M2 4c13-6 23 3 22 13M19 14l5 5 5-5" />
    </svg>
    <button type="button" id="season-pull-dismiss" aria-label="关闭换季提示">
      ×
    </button>
  </div>
</div>

<style>
  .season-pull {
    --cord-length: 88px;
    --pull-distance: 0px;
    position: fixed;
    top: 0;
    right: max(20px, env(safe-area-inset-right));
    width: 48px;
    height: calc(var(--cord-length) + 58px);
    z-index: 40;
    pointer-events: none;
  }
  .pull-mount {
    position: absolute;
    top: -4px;
    left: 17px;
    width: 14px;
    height: 11px;
    border-radius: 0 0 5px 5px;
    background: #b7a383;
    box-shadow:
      inset 0 -2px 2px #71593635,
      0 1px 3px #342f291a;
  }
  .pull-cord {
    position: absolute;
    top: 5px;
    left: 22px;
    width: 4px;
    height: calc(var(--cord-length) + var(--pull-distance));
    border-radius: 3px;
    background: repeating-linear-gradient(135deg, #ad9674 0 2px, #efe5ce 2px 4px);
    box-shadow: 1px 0 2px #4c382e25;
    transition: height 480ms cubic-bezier(0.22, 1.5, 0.42, 1);
  }
  .pull-handle {
    position: absolute;
    top: var(--cord-length);
    left: 0;
    width: 48px;
    height: 58px;
    display: grid;
    place-items: start center;
    padding: 4px 0 8px;
    border: 0;
    border-radius: 16px;
    background: transparent;
    pointer-events: auto;
    cursor: grab;
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
    -webkit-tap-highlight-color: transparent;
    transform: translateY(var(--pull-distance));
    transition: transform 480ms cubic-bezier(0.22, 1.5, 0.42, 1);
  }
  .pull-grip {
    width: 32px;
    height: 43px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    border: 1px solid color-mix(in srgb, var(--accent) 45%, #aa9272);
    border-radius: 11px 11px 14px 14px;
    color: var(--accent);
    background: linear-gradient(100deg, #e4d7bc, #fcf5e6 42%, #eaddc6);
    box-shadow:
      inset 0 1px 1px #fff9,
      1px 3px 5px #4c382e20;
    font: 18px/1 var(--serif);
  }
  .pull-grip svg,
  .hint-arrow {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .pull-handle:hover .pull-grip,
  .season-pull[data-ready='true'] .pull-grip {
    box-shadow:
      inset 0 1px 1px #fff9,
      0 3px 9px #4c382e30;
    border-color: var(--accent);
  }
  .season-pull[data-dragging='true'] .pull-handle {
    cursor: grabbing;
  }
  .season-pull[data-dragging='true'] .pull-handle,
  .season-pull[data-dragging='true'] .pull-cord {
    transition: none;
  }
  .pull-hint {
    position: absolute;
    top: calc(var(--cord-length) + 5px);
    right: 56px;
    display: flex;
    align-items: center;
    width: max-content;
    padding: 10px 31px 10px 13px;
    border: 1px solid #bca88066;
    border-radius: 3px;
    background: #fff8e8f2;
    color: #68553b;
    box-shadow: 0 4px 14px #4c382e0d;
    transform: rotate(-3deg);
    font: 13px/1.5 var(--serif);
    animation: hint-arrive 700ms ease-out both;
  }
  .hint-arrow {
    position: absolute;
    right: -28px;
    bottom: -15px;
    color: var(--accent);
  }
  #season-pull-dismiss {
    position: absolute;
    right: 0;
    top: 0;
    width: 28px;
    height: 100%;
    border: 0;
    background: transparent;
    color: #8c795f;
    font-size: 16px;
    cursor: pointer;
    pointer-events: auto;
  }
  @keyframes hint-arrive {
    from {
      opacity: 0;
      transform: translateY(-6px) rotate(-3deg);
    }
    to {
      opacity: 1;
      transform: translateY(0) rotate(-3deg);
    }
  }
  @media (max-width: 600px) {
    .season-pull {
      --cord-length: 72px;
      right: max(5px, env(safe-area-inset-right));
    }
    .pull-hint {
      right: 53px;
      padding-top: 8px;
      padding-bottom: 8px;
      font-size: 12px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pull-cord,
    .pull-handle {
      transition: none;
    }
    .pull-hint {
      animation: none;
    }
  }
  @media print {
    .season-pull {
      display: none;
    }
  }
</style>

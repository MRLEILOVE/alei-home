---
import { friendLinks, linkExchange } from '../data/community';

interface Props {
  guestbookHref?: string;
}
const { guestbookHref } = Astro.props;
---

<section id="friends" class="friends-section" aria-labelledby="friends-title">
  <div class="section-heading">
    <h2 id="friends-title">
      <small>05 / 友情链接</small>串个门，认识一些朋友
    </h2>
    {guestbookHref && (
      <a class="subtle-link" href={guestbookHref}>
        交换友链 <span aria-hidden="true">↓</span>
      </a>
    )}
  </div>
  {friendLinks.length > 0 ? (
    <ul class="friend-list">
      {friendLinks.map((friend) => (
        <li>
          <a class="friend-link" href={friend.url} target="_blank" rel="noopener noreferrer">
            <span class="friend-initial" aria-hidden="true">
              {Array.from(friend.name)[0]}
            </span>
            <span class="friend-copy">
              <strong>{friend.name}</strong>
              <span>{friend.description}</span>
            </span>
            <span class="friend-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <div class="friends-empty">
      <span class="neighbor-stamp" aria-hidden="true">
        邻
      </span>
      <div>
        <h3>这里留着几个空位。</h3>
        <p>
          等有趣的小站来做邻居。
          {guestbookHref
            ? '如果你也有自己的小天地，欢迎在留言板介绍一下。'
            : '第一批朋友的小站，正在慢慢收集。'}
        </p>
      </div>
    </div>
  )}
  <details class="link-exchange">
    <summary>交换友链时，可以带走这些信息</summary>
    <dl>
      <div>
        <dt>名称</dt>
        <dd>{linkExchange.name}</dd>
      </div>
      <div>
        <dt>地址</dt>
        <dd>
          <a href={linkExchange.url}>{linkExchange.url}</a>
        </dd>
      </div>
      <div>
        <dt>介绍</dt>
        <dd>{linkExchange.description}</dd>
      </div>
    </dl>
    {guestbookHref && (
      <p>
        在<a href={guestbookHref}>留言板</a>留下你的站点名称、网址和一句介绍，确认后会加入这里。
      </p>
    )}
  </details>
</section>

<style>
  .friends-section {
    padding: 38px 0;
    border-top: 1px solid var(--line);
  }
  .friend-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px 30px;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .friend-link {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line);
  }
  .friend-initial,
  .neighbor-stamp {
    display: grid;
    place-items: center;
    width: 44px;
    height: 48px;
    flex: 0 0 auto;
    border: 1px solid var(--line);
    color: var(--accent);
    font: 24px var(--serif);
    transform: rotate(-4deg);
  }
  .friend-copy {
    min-width: 0;
  }
  .friend-copy strong {
    display: block;
    font: 500 17px/1.5 var(--serif);
  }
  .friend-copy > span {
    display: block;
    margin-top: 5px;
    color: var(--muted);
    font-size: 12px;
    overflow-wrap: anywhere;
  }
  .friend-arrow {
    margin-left: auto;
    color: var(--muted);
  }
  .friend-link:hover strong,
  .friend-link:hover .friend-arrow {
    color: var(--accent);
  }
  .friends-empty {
    display: flex;
    align-items: center;
    gap: 23px;
    padding: 25px 28px;
    background: color-mix(in srgb, var(--paper) 65%, transparent);
    border: 1px dashed var(--line);
  }
  .friends-empty h3 {
    margin-bottom: 7px;
    font: 400 19px/1.5 var(--serif);
  }
  .friends-empty p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.9;
  }
  .link-exchange {
    margin-top: 23px;
    color: var(--muted);
    font-size: 12px;
  }
  .link-exchange summary {
    width: fit-content;
    max-width: 100%;
    cursor: pointer;
    padding: 8px 0;
  }
  .link-exchange summary:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }
  .link-exchange dl {
    display: grid;
    gap: 8px;
    margin: 12px 0;
  }
  .link-exchange dl > div {
    display: flex;
    gap: 18px;
  }
  .link-exchange dt {
    flex: 0 0 auto;
  }
  .link-exchange dd {
    margin: 0;
    color: var(--ink);
    overflow-wrap: anywhere;
  }
  .link-exchange p {
    margin-top: 16px;
  }
  .link-exchange a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 820px) {
    .friend-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .friends-section {
      padding: 28px 0;
    }
    .friend-list {
      grid-template-columns: 1fr;
    }
    .friends-empty {
      gap: 17px;
      padding: 21px 17px;
      align-items: start;
    }
    .neighbor-stamp {
      width: 35px;
      height: 41px;
      font-size: 22px;
    }
    .friends-empty h3 {
      font-size: 17px;
    }
    .friends-empty p {
      font-size: 12px;
    }
  }
</style>

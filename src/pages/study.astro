---
import Layout from '../layouts/Layout.astro';
import HomeContent from '../components/HomeContent.astro';
import SeasonAtmosphere from '../components/SeasonAtmosphere.astro';
import SeasonCurtain from '../components/SeasonCurtain.astro';
import Mascot from '../components/Mascot.astro';
import { getImage } from 'astro:assets';
import seasonsArt from '../assets/four-seasons.png';
import journalArt from '../assets/journal-cover-art-v1.png';
import { recommendedBooks } from '../data/leisure';
import '../styles/study.css';
const landscape = await getImage({ src: seasonsArt, width: 1600, format: 'webp' });
const journal = await getImage({ src: journalArt, width: 320, format: 'webp' });
const bookCovers = await Promise.all(
  recommendedBooks
    .filter((book) => book.ebook)
    .map(
      async (book) => (await getImage({ src: book.ebook!.cover, width: 166, format: 'webp' })).src,
    ),
);
const destinations = [
  ['writing', '01', '读点文字'],
  ['projects', '02', '看看作品'],
  ['music', '03', '听一会儿'],
  ['games', '04', '小游戏'],
  ['books', '05', '书籍推荐'],
  ['friends', '06', '友情链接'],
  ['guestbook', '07', '留言板'],
  ['main', '08', '关于阿雷'],
];
---

<Layout title="阿雷的3D小别墅 · 四季里，慢慢生活">
  <SeasonAtmosphere />
  <SeasonCurtain />
  <main class="study-app" id="room-main">
    <header class="room-header">
      <a
        class="room-brand"
        href={import.meta.env.BASE_URL}
        aria-label="阿雷的四季小别墅，返回原网站"
      >
        <span class="room-brand-mark" aria-hidden="true">
          <svg viewBox="0 0 64 64" width="56" height="56" fill="none" focusable="false">
            <path class="brand-roof" d="M11 31.5 29.5 16 46 30M16.5 28v12M41 27v13" />
            <path class="brand-stem" d="M43 26c3-3.5 3.3-7.8 4.5-11" />
            <path class="brand-leaf" d="M45.5 19C43.5 11.5 49 7.5 56 7c-.7 7.5-3.7 11.2-10.5 12Z" />
            <path class="brand-leaf-vein" d="m46 18 6.5-7" />
            <g class="brand-window">
              <rect x="25" y="28" width="5" height="5" rx="1" />
              <rect x="32" y="28" width="5" height="5" rx="1" />
              <rect x="25" y="35" width="5" height="5" rx="1" />
              <rect x="32" y="35" width="5" height="5" rx="1" />
            </g>
            <path
              class="brand-book"
              d="M8 41c8-1.5 15.5-.2 23 5.5 7.5-5.7 15-7 23-5.5v8c-8-1.3-15.5.2-23 5.5C23.5 49.2 16 47.7 8 49Z"
            />
            <path class="brand-pages" d="M12 44c6.5-.4 12 1.2 19 6M50 44c-6.5-.4-12 1.2-19 6" />
          </svg>
        </span>
        <span class="room-brand-copy">
          <span class="room-brand-title">
            <span class="room-brand-owner">阿雷的</span>
            <strong>四季小别墅</strong>
          </span>
          <small aria-hidden="true">FOUR SEASONS VILLA</small>
        </span>
      </a>
      <a class="room-return" href={import.meta.env.BASE_URL}>
        <svg viewBox="0 0 20 20" width="17" height="17" fill="none" aria-hidden="true">
          <path d="m3 9 7-6 7 6M5 8v9h10V8M8 17v-5h4v5" />
        </svg>
        <span>返回原网站</span>
        <span class="room-return-arrow" aria-hidden="true">
          ↗
        </span>
      </a>
    </header>
    <div class="room-intro">
      <span>THE VILLA / 四季别墅</span>
      <h1>
        把日子，
        <br />
        过成喜欢的样子。
      </h1>
      <p>
        三层小楼，一整个庭院。
        <br />
        楼下烟火，楼上欢聚，屋顶花开。
      </p>
    </div>
    <section
      id="room-stage"
      aria-label="半透明三层小别墅：一楼保留卧室、客厅、厨房与卫生间；二楼设有 KTV、私人影院和台球室；三楼为插着中国五星红旗的露天花园。楼后楼梯连接各层，庭院四周围有栅栏，保留车行和入户通道。院内有花园、鱼池、乌龟、小鱼、泳池、双石狮以及停着红色保时捷的半透明车库。"
      data-landscape={landscape.src}
      data-journal={journal.src}
      data-book-covers={JSON.stringify(bookCovers)}
    >
      <div id="room-canvas"></div>
      <div id="room-hotspots" aria-label="小别墅物件">
        <Mascot mode="room" />
      </div>
    </section>
    <aside class="room-life" aria-label="小阿雷的一天">
      <div class="room-life-clock">
        <span id="life-light" aria-hidden="true">
          ☀
        </span>
        <time id="life-clock">--:--</time>
        <span id="life-day">当地时间</span>
      </div>
      <p id="life-activity" aria-live="polite">
        和此刻的生活，同步。
      </p>
      <div class="room-life-track" aria-hidden="true">
        <i id="life-progress"></i>
      </div>
      <div class="room-life-controls">
        <button id="life-pause" type="button" aria-pressed="false">
          暂停活动
        </button>
        <span>与现实同步</span>
      </div>
      <small>跟随你所在地的时间，过好每一刻。</small>
    </aside>
    <div class="room-tools">
      <select id="room-floor" aria-label="查看楼层">
        <option value="all">整栋全景</option>
        <option value="first">一楼 · 生活空间</option>
        <option value="second">二楼 · 娱乐空间</option>
        <option value="roof">三楼 · 露天花园</option>
      </select>
      <button id="room-reset" type="button">
        ↺ 回到全景
      </button>
      <button id="room-follow" type="button" aria-pressed="false">
        跟随小阿雷
      </button>
      <button id="room-labels" type="button" aria-pressed="false">
        显示场景标注
      </button>
    </div>
    <div class="room-caption">
      <span class="room-dot"></span>
      <span id="room-status" role="status">
        正在搭建小别墅全景… 内容可以通过下方目录打开。
      </span>
      <button id="room-audio" type="button" hidden>
        Ⅱ 暂停音乐
      </button>
    </div>
    <nav class="room-nav" aria-label="小别墅内容目录">
      {destinations.map(([id, number, label]) => (
        <a href={`#${id}`} data-room-open={id}>
          <small>{number}</small>
          {label}
        </a>
      ))}
    </nav>
    <footer class="room-footer">
      <span>深圳 · 中国</span>
      <span>春生 · 夏长 · 秋收 · 冬藏</span>
      <button type="button" data-room-open="signature">
        写在页末 ↗
      </button>
    </footer>
  </main>
  <dialog id="room-content" aria-label="小别墅内容">
    <div class="room-panel-bar">
      <span id="room-panel-title">小别墅里的日常</span>
      <button id="room-close" type="button" autofocus>
        回到别墅 ×
      </button>
    </div>
    <div class="room-panel-body">
      <HomeContent study />
    </div>
  </dialog>
  <noscript>
    <p class="room-noscript">
      3D 小别墅需要 JavaScript。<a href={import.meta.env.BASE_URL}>前往原网站阅读全部内容 →</a>
    </p>
  </noscript>
  <script>
    import '../scripts/study';
  </script>
</Layout>
